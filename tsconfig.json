{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"paths": {
			"@api": ["./apps/api/src/index.ts"],
			"@api/scripts/*": ["./apps/api/scripts/*"],
			"@api/*": ["./apps/api/src/*"],
			"@web": ["./apps/web/app"],
			"@web/*": ["./apps/web/app/*"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"verbatimModuleSyntax": true
	}
}
