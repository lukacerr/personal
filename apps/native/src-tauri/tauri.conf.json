{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Luka",
	"version": "0.1.0",
	"identifier": "software.luka.personal",
	"mainBinaryName": "luka",
	"build": {
		"frontendDist": "https://personal.luka.software"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Luka",
				"width": 1200,
				"height": 800,
				"minWidth": 360,
				"minHeight": 640,
				"resizable": true,
				"fullscreen": false,
				"backgroundColor": [0, 0, 0, 255],
				"zoomHotkeysEnabled": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["appimage"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"android": {
			"minSdkVersion": 24
		}
	}
}
