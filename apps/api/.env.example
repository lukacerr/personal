NODE_ENV=development
PORT=8080
DEPLOYMENT_URL=http://localhost:8080
LUKA_SECRET="<secret>"

DATABASE_URL=postgres://personal:personal-local-password@localhost:5432/personal
NEON_FETCH_ENDPOINT=http://localhost:4444/sql

# Official USD quote for Finance. Defaults to this value when unset; the test
# environment points it at a closed port on purpose.
DOLARAPI_URL=https://dolarapi.com/v1/dolares/oficial

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-upstash-token

S3_ENDPOINT=http://localhost:9000
# Only needed when the API reaches storage on a name the browser cannot resolve,
# such as `http://s3:9000` inside Compose. Outside Docker both are the same host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=luka
S3_ACCESS_KEY_ID=personal
S3_SECRET_ACCESS_KEY=personal-local-secret

GOOGLE_CLIENT_ID=29835008818-rcd4ma65hvl7oa65tacmhcj9193b7rut.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET="<secret>"

# Agent system: LLM providers and Tavily web search. Locally any non-empty
# value works — tests never call a provider and a dev-time 401 is expected.
ANTHROPIC_API_KEY="<secret>"
OPENAI_API_KEY="<secret>"
NOVITA_API_KEY="<secret>"
GOOGLE_GENERATIVE_AI_API_KEY="<secret>"
GROQ_API_KEY="<secret>"
TAVILY_API_KEY="<secret>"

# Conversión Office→PDF del Agent (opcional; Compose local o Cloud Run en producción)
GOTENBERG_URL="http://localhost:3000"
