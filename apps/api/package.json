{
	"name": "@personal/api",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build --compile --minify --outfile dist/server src/index.ts",
		"db:pull": "bun scripts/db-pull.ts",
		"dev": "bun --watch src/index.ts",
		"mig": "bunx drizzle-kit generate",
		"mig:push": "bunx drizzle-kit migrate",
		"test": "docker compose -f ../../docker-compose.yml --env-file .env.test up -d --wait db-proxy cache s3 gotenberg && docker compose -f ../../docker-compose.yml --env-file .env.test run --rm --no-deps s3-init && bun test --env-file .env.test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.41",
		"@ai-sdk/google": "^4.0.50",
		"@ai-sdk/openai": "^4.0.46",
		"@ai-sdk/openai-compatible": "^3.0.35",
		"@blocknote/core": "catalog:",
		"@elysia/cors": "^1.4.2",
		"@elysia/jwt": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@neondatabase/serverless": "^1.1.0",
		"@t3-oss/env-core": "catalog:",
		"@tavily/core": "^0.7.7",
		"@upstash/redis": "^1.38.1",
		"ai": "catalog:",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.2",
		"elysia": "catalog:",
		"elysia-helmet": "^3.1.0",
		"elysia-logger": "^0.5.2",
		"elysia-oauth2": "^2.1.0",
		"jsondiffpatch": "catalog:",
		"mammoth": "catalog:",
		"read-excel-file": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@elysia/eden": "catalog:",
		"@types/pg": "^8.21.0",
		"bun-types": "catalog:",
		"drizzle-kit": "^0.31.10",
		"pg": "^8.23.0",
		"typescript": "catalog:"
	}
}
